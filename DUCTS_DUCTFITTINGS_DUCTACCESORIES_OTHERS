# Importar librerías
import clr

# Revit API
clr.AddReference('RevitAPI')
from Autodesk.Revit.DB import *
from Autodesk.Revit.DB.Mechanical import Duct
from Autodesk.Revit.DB.Plumbing import Pipe

clr.AddReference('RevitNodes')
import Revit
clr.ImportExtensions(Revit.Elements)

# Entrada
elements = IN[0]

# Asegurar lista
if not isinstance(elements, list):
    elements = [elements]

# Listas
ducts = []
ductFittings = []
ductAccessories = []
mechanicalEquipment = []
others = []

# Recorrer elementos
for elem in elements:

    revitElem = elem.InternalElement

    added = False

    # Ducts
    if isinstance(revitElem, Duct):
        ducts.append(elem)
        added = True

    # Family Instances
    elif isinstance(revitElem, FamilyInstance):

        category = revitElem.Category

        if category:

            catId = category.Id.IntegerValue

            # Duct Fittings
            if catId == int(BuiltInCategory.OST_DuctFitting):
                ductFittings.append(elem)
                added = True

            # Duct Accessories
            elif catId == int(BuiltInCategory.OST_DuctAccessory):
                ductAccessories.append(elem)
                added = True

            # Mechanical Equipment
            elif catId == int(BuiltInCategory.OST_MechanicalEquipment):
                mechanicalEquipment.append(elem)
                added = True

    # Otros elementos
    if not added:
        others.append(elem)

# Salidas
OUT = (
    ducts,                # OUT[0]
    ductFittings,         # OUT[1]
    ductAccessories,      # OUT[2]
    mechanicalEquipment,  # OUT[3]
    others                # OUT[4]
)